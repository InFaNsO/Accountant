[Unit]
Description=Ledger — Flask Business App
Documentation=https://github.com/InFaNsO/Accountant
After=network.target

[Service]
Type=simple
User=ledger
Group=ledger
WorkingDirectory=/home/ledger/app

# Environment
Environment="PATH=/home/ledger/app/venv/bin"
Environment="SECRET_KEY=changeme"
Environment="FLASK_ENV=production"

# Gunicorn: 2 workers, bound to localhost only
ExecStart=/home/ledger/app/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --access-logfile /home/ledger/app/logs/access.log \
    --error-logfile  /home/ledger/app/logs/error.log \
    run:app

# Auto-restart on crash
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
