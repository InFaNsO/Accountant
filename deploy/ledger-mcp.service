[Unit]
Description=Ledger — MCP Server (SSE)
Documentation=https://github.com/InFaNsO/Accountant
After=network.target ledger.service

[Service]
Type=simple
User=ledger
Group=ledger
WorkingDirectory=/home/ledger/app

Environment="PATH=/home/ledger/app/venv/bin"
Environment="LEDGER_API_URL=http://127.0.0.1:5000"
Environment="LEDGER_API_KEY=changeme"
Environment="MCP_TRANSPORT=sse"
Environment="FASTMCP_TRANSPORT_SECURITY__ENABLE_DNS_REBINDING_PROTECTION=false"

ExecStart=/home/ledger/app/venv/bin/python mcp_server.py

Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
